<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.vikraman.site-preview</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>quarto</string>
        <string>preview</string>
        <string>--no-browser</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@SITE@</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>@HOME@/.cabal/bin:@HOME@/.local/bin:/usr/local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/Library/TeX/texbin:/Applications/quarto/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>@HOME@</string>
        <key>LANG</key>
        <string>C.UTF-8</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>ExitTimeOut</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/site-preview.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/site-preview.log</string>
</dict>
</plist>
